{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalMind",
  "version": "1.0.0-beta.1",
  "identifier": "com.localmind.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalMind",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Haroon Abbasi",
    "copyright": "Copyright 2026 Haroon Abbasi",
    "category": "DeveloperTool",
    "shortDescription": "Your private AI hub, always nearby.",
    "longDescription": "A desktop command center for free-tier AI tools, local AI servers and a local API key vault.",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
